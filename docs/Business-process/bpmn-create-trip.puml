@startuml bpmn-create-trip
title Создание поездки и приглашение участников
skinparam activityBorderColor #333333

|Пользователь|
start
:Открыть Trips/Index;
:Заполнить форму создания поездки\n(название, валюта);
|Система|
if (форма валидна?\n(BR-01: валюта = 3 буквы)) then (нет)
  |Пользователь|
  :Увидеть ошибки формы;
  -> вернуться к форме;
  detach
else (да)
  :Создать Trip (Status = Active);
  :Добавить организатора\nв trip_participants;
  :Сделать поездку активной в сессии;
endif

|Пользователь|
repeat
  :Открыть Trips/Details;
  if (пригласить участника?) then (да)
    :Ввести email приглашаемого;
    |Система|
    if (email зарегистрирован?) then (нет)
      :Показать ошибку\n"пользователь не найден";
      |Пользователь|
    else (да)
      if (поездка уже завершена?) then (да)
        :Показать ошибку\n(TripAlreadyFinishedException);
        |Пользователь|
      else (нет)
        :Добавить пользователя\nв trip_participants;
        |Пользователь|
        :Увидеть участника в списке;
      endif
    endif
  else (нет, закончить)
    break
  endif
repeat while (пригласить еще одного?) is (да)
->нет;
stop
@enduml
