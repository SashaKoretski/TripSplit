@startuml
skinparam linetype ortho
skinparam nodesep 150
skinparam ranksep 150

hide circle
hide methods
hide stereotypes

entity "Пользователь" as User {
    id
    --
    имя
}

entity "Поездка" as Trip {
    id
    --
    название
    статус
    валюта
}

entity "Чек" as Receipt {
    id
    --
    название
    дата
}

entity "Изображение чека" as ReceiptImage {
    id
    --
    storage_key (S3)
    тип файла
    размер
    имя файла
    загружено
}

entity "Расход" as Expense {
    id
    --
    название
    тип
    сумма
    скидка
}

entity "Перевод" as Transfer {
    --
    отправитель
    получатель
    сумма
}

entity "Статистика поездки" as Stats {
    --
    общая_сумма
    сумма_по_пользователям
}

' Основные связи
User    }o-left-o{ Trip      : "принадлежит"
Trip    ||-left-o{ Receipt   : "содержит"
Receipt ||-right-o{ Expense  : "группирует"
Receipt ||-down-o| ReceiptImage : "содержит фото"

Trip    ||-right-o{ Transfer : "формирует"

Trip    ||-down-|| Stats     : "имеет"

User    ||-down-o{ Expense   : "оплачивает"
User    }o-down-o{ Expense   : "потрачена на"

User    ||-right-o{ Transfer : "отправитель/получатель"

' Скрытые связи для более аккуратного расположения
Receipt -[hidden]-> Stats
Stats   -[hidden]-> Expense
Expense -[hidden]-> Transfer
@enduml